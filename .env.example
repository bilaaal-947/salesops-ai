# ── App ──────────────────────────────────────────────
ENVIRONMENT=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://salesops:salesops@postgres:5432/salesops
POSTGRES_USER=salesops
POSTGRES_PASSWORD=salesops
POSTGRES_DB=salesops

# ── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth (Supabase) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── LLM Providers ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL_FAST=
LLM_MODEL_REASONING=

# ── Observability ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=salesops-ai

# ── CRM: HubSpot ─────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── Email/Calendar: Google ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Slack ────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
